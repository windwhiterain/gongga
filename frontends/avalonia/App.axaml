<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Gongga.Avalonia.App"
             RequestedThemeVariant="Dark">
    <!-- One palette, one spacing scale, one type scale: every colour and every
         distance the window uses is named here, so a screen cannot invent a
         sixth gray. Contract: the semantic kinds come from
         crates/tui/src/render.rs style_for; only their ink is this file's. -->
    <Application.Resources>
        <ResourceDictionary>
            <!-- Surfaces, darkest to lightest. -->
            <SolidColorBrush x:Key="PageBrush" Color="#0A0D12" />
            <SolidColorBrush x:Key="ListBrush" Color="#0D1117" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#11161E" />
            <SolidColorBrush x:Key="RaisedBrush" Color="#161C26" />
            <SolidColorBrush x:Key="HoverBrush" Color="#1A212C" />
            <SolidColorBrush x:Key="SelectedBrush" Color="#1E2836" />
            <SolidColorBrush x:Key="CodeBrush" Color="#0C1017" />

            <!-- Lines: a hairline is structure, not decoration. -->
            <SolidColorBrush x:Key="HairlineBrush" Color="#1D242F" />
            <SolidColorBrush x:Key="StrongLineBrush" Color="#2A3442" />

            <!-- Type. -->
            <SolidColorBrush x:Key="InkBrush" Color="#E6EBF2" />
            <SolidColorBrush x:Key="InkSoftBrush" Color="#AAB4C2" />
            <SolidColorBrush x:Key="InkMutedBrush" Color="#6E7889" />
            <SolidColorBrush x:Key="InkFaintBrush" Color="#4B5462" />

            <!-- The one accent: focus, the sticky window, the mark that says "here". -->
            <SolidColorBrush x:Key="AccentBrush" Color="#6EA8FE" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#24344D" />
            <SolidColorBrush x:Key="AccentInkBrush" Color="#BBD4FF" />

            <!-- Semantic rows: same five hues as the terminal, at a darker tint. -->
            <SolidColorBrush x:Key="KindSystemBrush" Color="#6E7889" />
            <SolidColorBrush x:Key="KindCommandBrush" Color="#C79BE8" />
            <SolidColorBrush x:Key="KindUserBrush" Color="#F0A6D8" />
            <SolidColorBrush x:Key="KindInjectBrush" Color="#6FD3D3" />
            <SolidColorBrush x:Key="KindAssistantBrush" Color="#DCE3EC" />
            <SolidColorBrush x:Key="KindReasoningBrush" Color="#7C8697" />
            <SolidColorBrush x:Key="KindToolCallBrush" Color="#E3C46B" />
            <SolidColorBrush x:Key="KindToolOutputBrush" Color="#7FB8EE" />
            <SolidColorBrush x:Key="KindToolErrorBrush" Color="#EE9090" />
            <SolidColorBrush x:Key="KindResultBrush" Color="#79CE96" />
            <SolidColorBrush x:Key="KindErrorBrush" Color="#F07C7C" />

            <FontFamily x:Key="MonoFamily">Consolas, Cascadia Mono, monospace</FontFamily>

            <!-- The spacing scale: 4, 6, 8, 12, 16, 24. Nothing else is a distance. -->
            <Thickness x:Key="PanePadding">16,12</Thickness>
            <Thickness x:Key="CardPadding">12,9</Thickness>
            <Thickness x:Key="ChipPadding">8,2</Thickness>

            <CornerRadius x:Key="Radius">8</CornerRadius>
            <CornerRadius x:Key="RadiusSmall">6</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector="TextBlock">
            <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
        </Style>
        <!-- Fluent's own chrome is loud at this size: the scrollbars are hairlines
             that only thicken when the pointer is over them. -->
        <Style Selector="ScrollBar:vertical">
            <Setter Property="Width" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="8" />
        </Style>
    </Application.Styles>
</Application>
