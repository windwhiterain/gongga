<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Gongga.Avalonia.ViewModels"
        xmlns:wire="clr-namespace:Gongga.Avalonia.Wire"
        xmlns:v="clr-namespace:Gongga.Avalonia.Views"
        x:Class="Gongga.Avalonia.MainWindow"
        x:DataType="vm:ClientModel"
        Width="1320" Height="860"
        MinWidth="760" MinHeight="480"
        Background="{StaticResource PageBrush}"
        Title="gongga"
        Closed="OnClosed">

    <Window.Resources>
        <v:KindBrushConverter x:Key="KindBrush" />
        <v:ContentBrushConverter x:Key="ContentBrush" />
        <v:StickyBrushConverter x:Key="StickyBrush" />
        <v:SelectedBrushConverter x:Key="SelectedBrush" />
        <v:IndentConverter x:Key="Indent" />
        <v:BodyBrushConverter x:Key="BodyBrush" />

        <!-- One block of a window's log: the fold's own column, the kind's mark, then
             the words. An answer is drawn at its own length; a block that folds is
             capped at SPEC's `block_size` and scrolls inside. -->
        <DataTemplate x:Key="BlockTemplate" x:DataType="vm:BlockRow" DataType="vm:BlockRow">
            <Border Background="Transparent" CornerRadius="{StaticResource RadiusSmall}"
                    Padding="6,4" Margin="0,1" PointerPressed="OnBlockPressed">
                <Grid ColumnDefinitions="12,16,*">
                    <TextBlock Text="{Binding FoldMark}" IsVisible="{Binding Foldable}"
                               VerticalAlignment="Top" FontSize="10" Margin="0,3,0,0"
                               Foreground="{StaticResource InkFaintBrush}" />
                    <TextBlock Grid.Column="1" Text="{Binding Mark}" VerticalAlignment="Top"
                               FontSize="12" Margin="0,2,0,0"
                               Foreground="{Binding Kind, Converter={StaticResource KindBrush}}" />
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="{Binding Tag}" IsVisible="{Binding HasTag}"
                                   FontSize="11" Margin="0,0,0,2"
                                   Foreground="{StaticResource InkMutedBrush}" />
                        <Border Background="{Binding Kind, Converter={StaticResource BodyBrush}}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="0">
                        <ScrollViewer MaxHeight="{Binding BodyHeight}"
                                      Margin="{Binding EdgeMargin}"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- A document: the rows the client made, one control each. -->
                                <ItemsControl ItemsSource="{Binding Rows}" IsVisible="{Binding HasRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:SpanRow" DataType="vm:SpanRow">
                                            <v:SpanLine Spans="{Binding Spans}"
                                                        TextWrapping="Wrap"
                                                        FontFamily="{StaticResource MonoFamily}"
                                                        FontSize="13" LineHeight="20"
                                                        Foreground="{Binding Kind, Converter={StaticResource ContentBrush}}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- A line of tool output: text, as it came. -->
                                <SelectableTextBlock Text="{Binding DisplayText}" TextWrapping="Wrap"
                                                     IsVisible="{Binding !HasRows}"
                                                     FontFamily="{StaticResource MonoFamily}"
                                                     FontSize="13" LineHeight="20" />
                            </StackPanel>
                        </ScrollViewer>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Head.Fields}"
                                      IsVisible="{Binding Structured}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="wire:HeadField" DataType="wire:HeadField">
                                    <Grid ColumnDefinitions="130,*" Margin="0,1">
                                        <TextBlock Text="{Binding Label}" FontSize="11"
                                                   Foreground="{StaticResource InkMutedBrush}" />
                                        <SelectableTextBlock Grid.Column="1" Text="{Binding Value}"
                                                             TextWrapping="Wrap" FontSize="11"
                                                             FontFamily="{StaticResource MonoFamily}"
                                                             Foreground="{StaticResource InkSoftBrush}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- One session drawn beside the list: a header strip that names it, then its
             own rows. The sticky window is the one with an accent edge. -->
        <DataTemplate x:Key="PaneTemplate" x:DataType="vm:PaneRow" DataType="vm:PaneRow">
            <Border Margin="8" CornerRadius="{StaticResource Radius}" BorderThickness="1"
                    BorderBrush="{Binding Sticky, Converter={StaticResource StickyBrush}}"
                    Background="{StaticResource SurfaceBrush}" ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="{StaticResource RaisedBrush}"
                            Padding="14,9" Tag="{Binding Name}" PointerPressed="OnPaneHeaderPressed">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"
                                           Foreground="{StaticResource InkBrush}" />
                                <Border IsVisible="{Binding Sticky}" VerticalAlignment="Center"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="{StaticResource RadiusSmall}"
                                        Padding="{StaticResource ChipPadding}">
                                    <TextBlock Text="sticky" FontSize="10"
                                               Foreground="{StaticResource AccentInkBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Title}" IsVisible="{Binding HasTitle}"
                                       Margin="0,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource InkMutedBrush}" />
                        </StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" Tag="{Binding Name}"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto"
                                  Padding="{StaticResource PanePadding}"
                                  Loaded="OnPaneLoaded" Unloaded="OnPaneUnloaded"
                                  ScrollChanged="OnPaneScrollChanged">
                        <ItemsControl ItemsSource="{Binding Blocks}"
                                      ItemTemplate="{StaticResource BlockTemplate}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid RowDefinitions="Auto,*,Auto,Auto,Auto,Auto">

        <!-- The bar: what this window is, whose server it reads, and what that server
             said last. -->
        <Border Grid.Row="0" Padding="18,10" BorderBrush="{StaticResource HairlineBrush}"
                BorderThickness="0,0,0,1" Background="{StaticResource PageBrush}">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                <TextBlock Text="gongga" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource InkBrush}" VerticalAlignment="Center" />
                <Border Grid.Column="1" Margin="12,0,0,0" Padding="{StaticResource ChipPadding}"
                        CornerRadius="{StaticResource RadiusSmall}"
                        Background="{StaticResource AccentSoftBrush}" VerticalAlignment="Center"
                        IsVisible="{Binding ServerOurs}">
                    <TextBlock Text="own" FontSize="10" Foreground="{StaticResource AccentInkBrush}" />
                </Border>
                <TextBlock Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                           Text="{Binding ServerText}" FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource InkMutedBrush}" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11"
                           Text="{Binding StatusText}"
                           Foreground="{Binding StatusKind, Converter={StaticResource KindBrush}}" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="292,*">
            <!-- A list, not a selector: what it lights up is which windows are open
                 (Layout.shown), and a group row folds the names under it. -->
            <Border Grid.Column="0" Background="{StaticResource ListBrush}"
                    BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,1,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,8">
                    <ItemsControl ItemsSource="{Binding Sessions}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SessionRow" DataType="vm:SessionRow">
                                <Border Background="{Binding RowBrush}" CornerRadius="{StaticResource RadiusSmall}"
                                        BorderBrush="{Binding BarBrush}" BorderThickness="2,0,0,0"
                                        Padding="10,6" Margin="8,1" Tag="{Binding Name}"
                                        PointerPressed="OnSessionPressed">
                                    <Grid ColumnDefinitions="Auto,Auto,Auto,*">
                                        <TextBlock Text="{Binding FoldMark}" FontSize="11"
                                                   VerticalAlignment="Center" Width="12"
                                                   Foreground="{StaticResource InkMutedBrush}"
                                                   Tag="{Binding Name}" PointerPressed="OnFoldPressed"
                                                   IsVisible="{Binding HasChildren}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Mark}" FontSize="10"
                                                   Margin="4,1,0,0" VerticalAlignment="Center" Width="14"
                                                   Foreground="{Binding MarkKind, Converter={StaticResource KindBrush}}" />
                                        <StackPanel Grid.Column="3">
                                            <TextBlock Text="{Binding Label}" FontSize="13"
                                                       Margin="{Binding Indent, Converter={StaticResource Indent}}"
                                                       Foreground="{Binding NameBrush}" />
                                            <TextBlock Text="{Binding Title}" IsVisible="{Binding HasTitle}"
                                                       FontSize="11" Margin="0,3,0,0"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource InkMutedBrush}"
                                                       ToolTip.Tip="{Binding Title}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <TextBlock Grid.Column="1" IsVisible="{Binding NoPanes}"
                       Text="No session open — pick one on the left."
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource InkFaintBrush}" FontSize="13" />

            <ItemsControl x:Name="PaneArea" Grid.Column="1" ItemsSource="{Binding Panes}"
                          ItemTemplate="{StaticResource PaneTemplate}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
        </Grid>

        <!-- SPEC's `active_quota`: the providers asked most recently, side by side and
             wrapped at the window's width. -->
        <Border Grid.Row="2" Padding="18,6" IsVisible="{Binding HasQuota}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
            <ItemsControl ItemsSource="{Binding Quota}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="wire:QuotaItem" DataType="wire:QuotaItem">
                        <Border Background="{StaticResource RaisedBrush}"
                                CornerRadius="{StaticResource RadiusSmall}"
                                Padding="10,3" Margin="0,0,8,0">
                            <TextBlock Text="{Binding Text}" FontSize="11"
                                       Foreground="{Binding Kind, Converter={StaticResource KindBrush}}" />
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Border Grid.Row="3" Padding="18,4" Background="{StaticResource ListBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
            <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding CommandBlocks}"
                              ItemTemplate="{StaticResource BlockTemplate}" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" RowDefinitions="Auto,Auto">
            <!-- Completion: an elevated card over the input, never a row of the log. -->
            <Border Grid.Row="0" IsVisible="{Binding CompletionVisible}"
                    Margin="18,8,18,0" Padding="10,8"
                    CornerRadius="{StaticResource Radius}"
                    Background="{StaticResource RaisedBrush}"
                    BorderBrush="{StaticResource StrongLineBrush}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding CompletionSubject}" FontSize="10" Margin="2,0,0,6"
                               Foreground="{StaticResource InkMutedBrush}" />
                    <ListBox ItemsSource="{Binding Candidates}" MaxHeight="180"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:CandidateView" DataType="vm:CandidateView">
                                <Border Padding="8,3" CornerRadius="{StaticResource RadiusSmall}"
                                        PointerPressed="OnCandidatePressed"
                                        Background="{Binding Selected, Converter={StaticResource SelectedBrush}}">
                                    <Grid ColumnDefinitions="220,*">
                                        <TextBlock Text="{Binding Insert}" FontSize="12"
                                                   FontFamily="{StaticResource MonoFamily}"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Detail}" FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Foreground="{StaticResource InkMutedBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <TextBox x:Name="Input" Grid.Row="1" AcceptsReturn="True"
                     TextWrapping="Wrap" MinHeight="64" MaxHeight="200"
                     Margin="18,10,18,8" Padding="12,10"
                     CornerRadius="{StaticResource Radius}"
                     Background="{StaticResource CodeBrush}" Foreground="{StaticResource InkBrush}"
                     CaretBrush="{StaticResource AccentBrush}"
                     SelectionBrush="{StaticResource AccentSoftBrush}"
                     BorderThickness="1" BorderBrush="{StaticResource StrongLineBrush}"
                     PlaceholderText="Message the sticky session, or type / for a command"
                     PlaceholderForeground="{StaticResource InkFaintBrush}"
                     FontFamily="{StaticResource MonoFamily}" FontSize="13"
                     Text="{Binding InputText, Mode=TwoWay}"
                     TextChanged="OnInputTextChanged" />
        </Grid>

        <Border Grid.Row="5" Padding="18,7" Background="{StaticResource PageBrush}"
                BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding HelpText}" FontSize="11"
                           Foreground="{StaticResource InkFaintBrush}" />
                <TextBlock Grid.Column="1" Text="{Binding Toast}" Margin="16,0,0,0"
                           FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource KindToolCallBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
