#!/usr/bin/env bash
# Refuse a commit whose pinned content and published content disagree.
#
# A pin is two names for one commit: `ship/` is the content a person edits, and
# `crates/server/ship.toml` is what a server installs. `scripts/ship.sh` keeps
# them equal -- but nothing stopped a commit from carrying a pin whose commit was
# never pushed. A fresh machine cannot fetch that commit, and the install used to
# report success while writing no file at all, so the failure surfaced on somebody
# else's first start as "no prompt templates", pointing at the wrong thing.
#
# Invariant
#
# A commit never depends on the network. `--check` answers 3 for "could not tell",
# and this lets that through with the line printed: unreachable is a warning to
# read, not a reason to be unable to work. A real disagreement is refused, because
# that is a fact about the commit being made, not about the link.
#
# Tracked here rather than in `.git/hooks` so it is the same for every checkout;
# install it once per clone:
#
#     git config core.hooksPath scripts/hooks
set -uo pipefail

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0
# A clone without its submodules has no content to disagree with yet.
[[ -d ship/.git || -f ship/.git ]] || exit 0
[[ -f scripts/ship.sh ]] || exit 0

# A skill's body is read by whatever harness installed it, so a line that runs its own
# script has to be spelled in the one way every harness resolves -- from the directory the
# `SKILL.md` was read from. The install paths this harness happens to use
# (`$GONGGA_HOME/skills/...`, `.../gongga-agents/skills/...`) work here and nowhere else,
# and they break here too when the home moves. The content lives in a submodule, so any
# commit that moves it shows up as one path: `ship`.
if git diff --cached --name-only | grep -qE '^ship$|(^|/)\.agents/skills/'; then
  if ! out=$(bash scripts/skill_contract.sh 2>&1); then
    printf '%s\n' "$out" | sed 's/^/  /' >&2
    cat >&2 <<'WHY'

pre-commit: a skill names this harness's own install path, or its `metadata.entry`
points at nothing.

  Another harness reads the same body: it has no `<home>/skills`, no clone, and no
  `$GONGGA_HOME`. Spell the entry from the skill's own directory instead --

      SKILL_DIR=<the directory this SKILL.md is in>
      "$SKILL_DIR/scripts/thing" ...

  and declare it once where the specification allows an extension:

      metadata:
        entry: scripts/thing

  In gongga the shorter spelling is `gongga-cli skill <name> [args...]`.
WHY
    exit 1
  fi
fi

# Nothing about the pin is being committed: no round trip, no opinion.
if ! git diff --cached --name-only | grep -qxE 'ship|crates/server/ship\.toml'; then
	exit 0
fi

# `git commit` exports the index it is writing (`GIT_INDEX_FILE`, and in some versions
# more). The check reads the submodule's *own* index, and inheriting this one makes it
# read the parent's: it reported the parent's HEAD as the content's, and the parent's
# whole tree as deleted in `ship/`. So the check runs with that environment cleared.
out=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_OBJECT_DIRECTORY \
  -u GIT_PREFIX bash scripts/ship.sh --check 2>&1)
code=$?
case $code in
0) exit 0 ;;
3)
	printf 'ship: cannot verify the pin -- the remote did not answer.\n' >&2
	printf '%s\n' "$out" | sed 's/^/  /' >&2
	printf 'ship: committing anyway; run scripts/ship.sh --check when back online.\n' >&2
	exit 0
	;;
*)
	printf '%s\n' "$out" | sed 's/^/  /' >&2
	cat >&2 <<'WHY'

ship: this commit carries a pin that disagrees with the shipped content.

  The pin is `crates/server/ship.toml`; the content is `ship/`. A fresh machine
  has to be able to fetch that exact commit -- a sha that exists only in this
  working tree installs nothing.

  Publish first, then commit:

      scripts/ship.sh -m "what changed"   # commits ship/, pushes, writes the pin
      git commit                          # now the names agree

  Committing something else while the pin is in flux? Leave it out:

      git restore --staged ship crates/server/ship.toml
WHY
	exit 1
	;;
esac
