#!/usr/bin/env bash
# Refuse a commit whose content this build could not install.
#
# `crates/server/ship.toml` names the protocol this build reads; a server asks
# ship's branch for the newest commit that speaks it, so nothing here names a
# commit and pushing content needs no commit over there. What a commit *can* still
# get wrong is the protocol itself: publish content one protocol ahead of the build
# that reads it and every machine silently keeps installing the last commit it can
# read -- a wording fix that never arrives, which is the failure this refuses.
#
# Invariant
#
# A commit never depends on the network: `--check --local` asks the two manifests
# and nothing else, so a clone with no link still knows whether its own content is
# readable by its own build.
#
# Tracked here rather than in `.git/hooks` so it is the same for every checkout;
# install it once per clone:
#
#     git config core.hooksPath scripts/hooks
set -uo pipefail

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
cd "$root" || exit 0
# A clone without its submodules has no content to disagree with yet.
[[ -d ship/.git || -f ship/.git ]] || exit 0
[[ -f scripts/ship.sh ]] || exit 0

# A skill's body is read by whatever harness installed it, so a line that runs its own
# script has to be spelled in the one way every harness resolves -- from the directory the
# `SKILL.md` was read from. The install paths this harness happens to use
# (`$GONGGA_HOME/skills/...`, `.../gongga-agents/skills/...`) work here and nowhere else,
# and they break here too when the home moves. The content lives in a submodule, so any
# commit that moves it shows up as one path: `ship`.
if git diff --cached --name-only | grep -qE '^ship$|(^|/)\.agents/skills/'; then
  if ! out=$(bash scripts/skill_contract.sh 2>&1); then
    printf '%s\n' "$out" | sed 's/^/  /' >&2
    cat >&2 <<'WHY'

pre-commit: a skill names this harness's own install path, or its `metadata.entry`
points at nothing.

  Another harness reads the same body: it has no `<home>/skills`, no clone, and no
  `$GONGGA_HOME`. Spell the entry from the skill's own directory instead --

      SKILL_DIR=<the directory this SKILL.md is in>
      "$SKILL_DIR/scripts/thing" ...

  and declare it once where the specification allows an extension:

      metadata:
        entry: scripts/thing

  In gongga the shorter spelling is `gongga-cli skill <name> [args...]`.
WHY
    exit 1
  fi
fi

# Nothing about the content's protocol is being committed: no round trip, no opinion.
if ! git diff --cached --name-only | grep -qxE 'ship|crates/server/ship\.toml'; then
	exit 0
fi

# `git commit` exports the index it is writing (`GIT_INDEX_FILE`, and in some versions
# more). The check reads the submodule's *own* index, and inheriting this one makes it
# read the parent's: it reported the parent's HEAD as the content's, and the parent's
# whole tree as deleted in `ship/`. So the check runs with that environment cleared.
#
# `--local`: a commit cannot depend on the network, and there is nothing here for the
# network to answer -- no commit is named anywhere, so whether the content is pushed
# yet only decides when the next start installs it, not whether this commit is sound.
out=$(env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_OBJECT_DIRECTORY \
  -u GIT_PREFIX bash scripts/ship.sh --check --local 2>&1)
code=$?
case $code in
0) exit 0 ;;
*)
	printf '%s\n' "$out" | sed 's/^/  /' >&2
	cat >&2 <<'WHY'

ship: this commit ships content that does not speak this build's protocol.

  `crates/server/ship.toml` names the protocol this build reads; `ship/ship.toml`
  says which the content is. A server installs the newest commit of ship's branch
  that speaks its own protocol, so a mismatch means the content it just shipped is
  invisible -- or that an older build silently keeps installing the last commit it
  could read.

  Cut one side over at a time:

      # content moves first, and builds read it after
      scripts/ship.sh -m "protocol 2: ..."    # commits ship/ and pushes it
      # then raise `protocol` in crates/server/ship.toml and build

  A wording fix, a new skill, a retired path -- none of those is a protocol change,
  and none of them needs this file touched.
WHY
	exit 1
	;;
esac
